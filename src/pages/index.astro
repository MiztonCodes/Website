---
import '../styles/global.css';
import { fetchBlogPosts } from '../services/devto';
import BlogLayout from '../layouts/BlogLayout.astro';

export const prerender = false;

const {articles, fetchError} = await fetchBlogPosts()
---
<BlogLayout>
  <div class="w-full max-w-200 flex flex-col gap-7.5">
    <div class="bg-[#1e1e1e] border border-[#333333] rounded-xl p-[25px_20px] min-[651px]:p-10 shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
      <div class="flex flex-col min-[651px]:flex-row items-center gap-6.25 min-[651px]:gap-10 mb-7.5 text-center min-[651px]:text-left">
        <div class="text-center min-w-37.5">
          <img
            src="/default-media/profile.png"
            alt="Mizton profile image"
            class="w-30 h-30 object-cover rounded-full mx-auto mb-3.75 border-[3px] border-[#333333] block transition-colors duration-300 hover:border-[#0e90bb]"
          />
          <h2 class="text-[1.3rem] font-bold mt-2.5 mb-0">Mizton</h2>
        </div>
        <div>
          <div class="flex flex-col gap-2.5 border-t-[3px] min-[651px]:border-t-0 min-[651px]:border-l-4 border-[#0e90bb] pt-5 min-[651px]:pt-0 pl-0 min-[651px]:pl-6.25 mb-6">
            <p class="text-[1.3rem] italic text-white m-0 leading-[1.4]">
              "The question of whether a computer can think is no more interesting than the question of whether a submarine can swim."
            </p>
            <cite class="text-[0.9rem] text-[#888888] font-bold not-italic">
              — Edsger W. Dijkstra
            </cite>
          </div>
          <div class="leading-[1.6] text-[#bbbbbb]">
            <p>
              As a software engineer in the age of AI, when machines produce code faster than any human, mastering the foundations of science and engineering is a must, to supervise, correct and refine the output to get the highest quality.
            </p>
          </div>
        </div>
      </div>

      <div class="flex justify-center flex-wrap gap-5 border-t border-[#333333] pt-6.25">
        <a
          target="_blank"
          rel="noreferrer noopener"
          href="https://dev.to/mizton"
          class="text-[#888888] no-underline text-[0.95rem] font-medium flex items-center gap-2 transition-[color,transform] duration-300 hover:text-white hover:-translate-y-0.5"
        >
          <i class="bi bi-book text-[1.2rem]"></i> Blog
        </a>
        <a
          target="_blank"
          rel="noreferrer noopener"
          href="https://www.youtube.com/@miztondev"
          class="text-[#888888] no-underline text-[0.95rem] font-medium flex items-center gap-2 transition-[color,transform] duration-300 hover:text-white hover:-translate-y-0.5"
        >
          <i class="bi bi-youtube text-[1.2rem]"></i> YouTube
        </a>
        <a
          target="_blank"
          rel="noreferrer noopener"
          href="https://github.com/MiztonCodes"
          class="text-[#888888] no-underline text-[0.95rem] font-medium flex items-center gap-2 transition-[color,transform] duration-300 hover:text-white hover:-translate-y-0.5"
        >
          <i class="bi bi-github text-[1.2rem]"></i> Github
        </a>
        <a
          target="_blank"
          rel="noreferrer noopener"
          href="https://x.com/miztondev"
          class="text-[#888888] no-underline text-[0.95rem] font-medium flex items-center gap-2 transition-[color,transform] duration-300 hover:text-white hover:-translate-y-0.5"
        >
          <i class="bi bi-twitter-x text-[1.2rem]"></i> Twitter-X
        </a>
        <a
          target="_blank"
          rel="noreferrer noopener"
          href="https://www.linkedin.com/in/swe-alberto/"
          class="text-[#888888] no-underline text-[0.95rem] font-medium flex items-center gap-2 transition-[color,transform] duration-300 hover:text-white hover:-translate-y-0.5"
        >
          <i class="bi bi-linkedin text-[1.2rem]"></i> LinkedIn
        </a>
      </div>
    </div>

    <div>
      <div class="flex items-center gap-2.5 my-5 mb-2.5 pb-2.5 border-b border-[#333333]">
        <i class="bi bi-journals text-[1.4rem] text-[#0e90bb]"></i>
        <h2 class="m-0 text-[1.5rem] font-bold">Latest Articles</h2>
      </div>

      <div id="articles-container" class="grid grid-cols-1 min-[651px]:grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-5">
        {fetchError ? (
          <p class="text-[#888888]">Failed to load articles at this time.</p>
        ) : articles.length === 0 ? (
          <p class="text-[#888888]">No articles found yet.</p>
        ) : (
          articles.map((article) => {
            const date = new Date(article.published_at).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });

            return (
              <a
                href={article.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col gap-3.75 bg-[#1e1e1e] border border-[#333333] rounded-lg p-5 no-underline text-[#e0e0e0] transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,0,0,0.4)] hover:border-[#0e90bb]"
              >
                <h3 class="text-[1.1rem] font-semibold m-0 leading-[1.4]">{article.title}</h3>
                <div class="flex gap-3.75 text-[0.85rem] text-[#888888] mt-auto">
                  <span class="flex items-center gap-1.25" title="Reactions">
                    <i class="bi bi-heart"></i> {article.public_reactions_count}
                  </span>
                  <span class="flex items-center gap-1.25" title="Comments">
                    <i class="bi bi-chat-text"></i> {article.comments_count}
                  </span>
                  <span class="flex items-center gap-1.25" title="Published Date">
                    <i class="bi bi-calendar3"></i> {date}
                  </span>
                </div>
              </a>
            );
          })
        )}
      </div>
    </div>
  </div>
</BlogLayout>
